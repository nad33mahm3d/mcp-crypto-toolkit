{
  "name": "mcp-crypto-toolkit",
  "version": "1.1.0",
  "description": "Live crypto prices, conversion, gas tracker, portfolio tools and calculators for AI agents - MCP Server",
  "type": "module",
  "bin": { "mcp-crypto-toolkit": "./dist/index.js" },
  "files": ["dist"],
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "crypto",
    "bitcoin",
    "ethereum",
    "coingecko",
    "gas",
    "portfolio",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Nadeem Ahmed <ebox.nadeem@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/nad33mahm3d/mcp-crypto-toolkit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^3.0.0"
  }
}
