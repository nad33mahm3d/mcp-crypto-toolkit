{
  "name": "mcp-crypto-toolkit",
  "version": "1.2.6",
  "mcpName": "io.github.nad33mahm3d/mcp-crypto-toolkit",
  "description": "Live crypto prices, conversion, gas tracker, portfolio tools and calculators for AI agents - MCP Server",
  "type": "module",
  "bin": {
    "mcp-crypto-toolkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js",
    "start:http": "node dist/http.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspector": "npx @modelcontextprotocol/inspector dist/index.js",
    "prepack": "npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "crypto",
    "bitcoin",
    "ethereum",
    "coingecko",
    "gas",
    "portfolio",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Nadeem Ahmed <ebox.nadeem@gmail.com>",
  "homepage": "https://github.com/nad33mahm3d/mcp-crypto-toolkit#readme",
  "bugs": {
    "url": "https://github.com/nad33mahm3d/mcp-crypto-toolkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nad33mahm3d/mcp-crypto-toolkit.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
